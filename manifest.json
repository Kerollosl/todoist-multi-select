{
  "manifest_version": 3,
  "name": "Todoist Task Toolkit",
  "version": "1.3.0",
  "description": "Copy selected Todoist tasks as a clean list, with an optional board-grouping helper. Unofficial; not affiliated with Todoist.",
  "minimum_chrome_version": "111",
  "author": "Kerollos Lowandy",
  "permissions": ["clipboardWrite", "storage", "scripting"],
  "optional_host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://app.todoist.com/*",
        "https://todoist.com/*"
      ],
      "js": ["selectors.js", "content.js", "groups.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "Todoist Task Toolkit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
